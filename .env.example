# Universal Video Production Engine — Environment Configuration
# Copy this file to .env and adjust paths if needed. Zero paid API keys are required.

PORT=3000
HOST=0.0.0.0

# Storage Directories (relative to workspace root)
PROJECTS_DIR=./projects
CACHE_DIR=./cache
LOGS_DIR=./logs
MODELS_DIR=./models
EXPORTS_DIR=./exports

# Hardware Profile (4 GB VRAM Low-Memory Guardrails)
GPU_NAME=NVIDIA GeForce RTX 2050
VRAM_BUDGET_MB=4096
SYSTEM_RAM_GB=16
LOW_VRAM_MODE=true
MAX_CONCURRENT_HEAVY_JOBS=1

# Optional Local AI Providers (leave empty or default if not installed)
COMFYUI_API_URL=http://127.0.0.1:8188
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
PIPER_BINARY_PATH=
XTTS_ENABLED=false
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_COMPUTE=int8

# FFmpeg Binaries (auto-detected from PATH if empty)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
